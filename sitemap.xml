       and therefore must not depend on site.pages for discovery. -->
{% assign public_paths = "/" | split: "," %}
{% assign public_paths = public_paths | push: "/games/math-defender/" | push: "/games/math-defender/en/" | push: "/games/math-fighter/" | push: "/games/math-fighter/en/" | push: "/games/math-rain/" | push: "/games/memory-game/" | push: "/games/make-it-max/" | push: "/math-defender/journals/" | push: "/math-defender/en/journals/" %}
{% for path in public_paths %}
